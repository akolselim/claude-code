{
  "general": {
    "checkpointing": {
      "enabled": true,
      "autoSaveInterval": 300,
      "maxCheckpoints": 50,
      "compressionEnabled": true
    }
  },
  "context": {
    "fileName": "GEMINI.md"
  },
  "mcpServers": {
    "yargi_mcp": {
      "command": "uvx",
      "args": ["yargi-mcp"]
    },
    "mevzuat-mcp": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/saidsurucu/mevzuat-mcp",
        "mevzuat-mcp"
      ]
    },
    "github": {
      "command": "node",
      "args": [
        "C:\\Users\\selim\\AppData\\Roaming\\npm\\node_modules\\@modelcontextprotocol\\server-github\\dist\\index.js"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "timeout": 10000,
      "retries": 2
    },
    "docker-mcp": {
      "command": "uvx",
      "args": ["docker-mcp"],
      "timeout": 8000,
      "retries": 1
    }
  },
  "model": {
    "name": "gemini-2.0-flash"
  },
  "tools": {
    "sandbox": false
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "ui": {
    "theme": "Default",
    "hideContextSummary": false
  }
}
